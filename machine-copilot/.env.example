# Copy to .env and fill in for your deployment.

# Which machine model this instance serves (must match a processed_data/<model>.pkl collection)
MACHINE_MODEL=Apex-3200

# Anthropic API key for the cloud-fallback model. Leave blank to run fully
# offline — the gateway will use the local templated responder instead.
ANTHROPIC_API_KEY=

# Model to use when the cloud gateway is reachable
PRIMARY_MODEL=claude-sonnet-4-6

# Force fully offline mode even if a key is present (useful for testing the
# air-gapped code path, or for sites with no outbound internet by policy)
OFFLINE_MODE=false

# Retrieval tuning
RETRIEVAL_TOP_K=5
RERANK_TOP_N=3

# Telemetry simulation poll interval (seconds) — production replaces this
# with the real PLC/OPC-UA event cadence
TELEMETRY_POLL_SECONDS=2.0
